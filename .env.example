# https://www.opensubtitles.com/consumers adresinden oluşturduğun API anahtarı (sadece arama için kullanılır)
OS_API_KEY=

# Kullanıcı hesap bilgilerini ve SubDL/SubSource anahtarlarını eklenti adresinde şifrelemek için uzun, rastgele bir metin.
# Oluşturmak için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DİKKAT: Değiştirilirse herkesin eklenti adresi geçersiz olur, yeniden ayarlamaları gerekir.
CONFIG_SECRET=

# İsteğe bağlı: Upstash Redis kalıcı önbellek (boşsa sadece bellekte önbellek tutulur)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Yerel çalıştırma portu
PORT=7000

# İsteğe bağlı: eklentinin dışarıdan erişilen adresi (boş bırakılırsa otomatik algılanır)
PUBLIC_URL=
